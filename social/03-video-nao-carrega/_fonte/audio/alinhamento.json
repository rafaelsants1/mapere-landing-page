      "fim": 28.17,
      "naTake": [
        23.62,
        25.75
      ],
      "pausaDepois": 0.6,
      "pausaNaTake": 0.165
    },
    {
      "texto": "Aí, pelo app, não tem jeito: é ir pra outro posto.",
