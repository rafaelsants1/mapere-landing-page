      "fim": 23.06,
      "naTake": [
        18.065,
        21.085
      ],
      "pausaDepois": 0.9,
      "pausaNaTake": 0.315
    },
    {
      "texto": "A ideia nasceu em Aracaju, ouvindo motoristas e vendo o elétrico crescer.",
