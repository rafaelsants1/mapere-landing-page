---
// Ícones do protótipo A1: traço 2 px, grade 24 px, terminais redondos.
const caminhos = {
  livre: 'M5 12.5l4.5 4.5L19 7.5',
  ocupado: 'M12 3.5a8.5 8.5 0 1 0 0.01 0z M12 7.5v4.5l3 2',
  defeito: 'M7 7l10 10M17 7L7 17',
  seminfo: 'M9 9.2a3 3 0 1 1 4.4 2.6c-.9.5-1.4 1.1-1.4 2.2 M12 18.2v.1',
  mapa: 'M3 6.5l6-2.5 6 2.5 6-2.5v13.5l-6 2.5-6-2.5-6 2.5z M9 4v13.5 M15 6.5V20',
  coracao: 'M12 20s-7.5-4.6-7.5-10.2A4.2 4.2 0 0 1 12 7.3a4.2 4.2 0 0 1 7.5 2.5C19.5 15.4 12 20 12 20z',
  sino: 'M6 16.5V11a6 6 0 0 1 12 0v5.5l1.5 1.5h-15z M10 20.5a2 2 0 0 0 4 0',
  perfil: 'M12 4a4 4 0 1 0 0.01 0z M4.5 20.5c1.4-3.6 4.3-5.5 7.5-5.5s6.1 1.9 7.5 5.5',
  checkin: 'M12 21s-7-5.8-7-11.2a7 7 0 0 1 14 0C19 15.2 12 21 12 21z M9 10l2.2 2.2L15.2 8',
  bandeira: 'M5.5 21V4 M5.5 4h11l-2.5 4.5 2.5 4.5h-11',
  busca: 'M10.5 4a6.5 6.5 0 1 0 0.01 0z M15.5 15.5L20 20',
  filtros: 'M4 7h9 M17 7h3 M15 5v4 M4 17h3 M11 17h9 M9 15v4',
  voltar: 'M15 5l-7 7 7 7',
  seta: 'M5 12h14 M13 6l6 6-6 6',
  raio: 'M13 3L5.5 13.5h6L10.5 21 18.5 10.5h-6z',
  plugue: 'M9 3v5 M15 3v5 M6 8h12v3a6 6 0 0 1-12 0z M12 17v4',
  rota: 'M4 11l16-7-7 16-2-7z',
  mais: 'M12 5v14 M5 12h14',
} as const;

export type NomeIcone = keyof typeof caminhos;

interface Props {
  nome: NomeIcone;
  tamanho?: number;
  traco?: number;
  class?: string;
}

const { nome, tamanho = 24, traco = 2, class: classe } = Astro.props;
---

<svg
  class={classe}
  width={tamanho}
  height={tamanho}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={traco}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"><path d={caminhos[nome]}></path></svg
>
