---
// Tela 2 · Detalhe do posto, modo escuro. O HTML traz o estado final: check-in feito.
import Chip from './Chip.astro';
import Icone from './Icone.astro';
import { telaExemplo as t, type StatusId } from '../data/copy';
---

<div class="tela tela-escuro" data-tela="detalhe">
  <div class="tela-barra"><span>{t.horaDetalhe}</span><span class="tela-bateria"><i></i><b></b></span></div>

  <div class="tela-detalhe-corpo">
    <div class="tela-detalhe-acoes">
      <span class="tela-redondo"><Icone nome="voltar" tamanho={22} traco={2.2} /></span>
      <span class="tela-redondo"><Icone nome="coracao" tamanho={22} traco={2.2} /></span>
    </div>
    <p class="tela-detalhe-nome">{t.posto}</p>
    <p class="tela-detalhe-endereco">{t.endereco}</p>

    <div class="tela-detalhe-status">
      <Chip status="livre" grande />
      <span class="tela-fase tela-detalhe-idade">
        <span data-fase="antes" data-tela-fase="idade">{t.confirmadoCurto}</span>
        <span data-fase="depois" data-tela-fase="idade">{t.confirmadoAgora}</span>
      </span>
    </div>

    <div class="tela-detalhe-preco">
      <span>{t.potencia}</span>
      <span>{t.preco}</span>
    </div>

    <p class="tela-detalhe-titulo">{t.conectoresTitulo}</p>
    <ul class="tela-conectores">
      {
        t.conectores.map((c) => (
          <li>
            <span class="tela-redondo tela-conector-icone">
              <Icone nome="plugue" tamanho={20} />
            </span>
            <span class="tela-conector-texto">
              <strong>{c.nome}</strong>
              <span>{c.resumo}</span>
            </span>
            <span class="tela-plugues">
              {c.plugues.map((p) => (
                <span class="pin-corpo" data-st={p}>
                  <Icone nome={p as StatusId} tamanho={15} traco={3} />
                </span>
              ))}
            </span>
          </li>
        ))
      }
    </ul>

    <p class="tela-detalhe-titulo">{t.historicoTitulo}</p>
    <ol class="tela-historico">
      {
        t.historico.map((h) => (
          <li data-novo={h.novo ? '' : undefined}>
            {h.novo ? (
              <span class="tela-ponto" id="tela-ponto"><i /></span>
            ) : (
              <span class="pin-corpo" data-st={h.st}>
                <Icone nome={h.st as StatusId} tamanho={14} traco={3.2} />
              </span>
            )}
            <span class="tela-historico-texto">
              <strong>{h.texto}</strong>
              <span>{h.quando}</span>
            </span>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="tela-detalhe-botoes">
    <div class="tela-checkin" id="tela-checkin">
      <span class="tela-checkin-rotulo" data-fase="antes"><Icone nome="checkin" tamanho={22} traco={2.4} />{t.fazerCheckin}</span>
      <span class="tela-checkin-feito" data-fase="depois"><Icone nome="livre" tamanho={22} traco={2.6} />{t.checkinFeito}</span>
    </div>
    <div class="tela-secundarios">
      <span><Icone nome="bandeira" tamanho={19} traco={2.2} />{t.reportar}</span>
      <span><Icone nome="rota" tamanho={19} traco={2.2} />{t.abrirRota}</span>
    </div>
  </div>

  <span class="dedo" id="dedo"></span>
</div>

<style is:global>
  .tela-escuro {
    background: var(--noite);
    color: var(--linho);
  }

  .tela-detalhe-corpo {
    position: absolute;
    inset: 50px 0 0;
    padding: 6px 16px 0;
  }

  .tela-detalhe-acoes {
    display: flex;
    justify-content: space-between;
  }

  .tela-redondo {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background: var(--grafite);
  }

  .tela-detalhe-nome {
    margin-top: 10px;
    font-family: var(--fonte-titulo);
    font-weight: 800;
    font-size: 36px;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .tela-detalhe-endereco {
    margin-top: 6px;
    color: var(--texto-2-escuro);
  }

  .tela-detalhe-status {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 14px;
  }

  .tela-detalhe-idade {
    line-height: 1.3;
  }

  .tela-detalhe-preco {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-top: 12px;
    padding-bottom: 10px;
    border-bottom: 1.5px solid var(--borda-escura);
    font-family: var(--fonte-titulo);
    font-weight: 800;
    font-size: 26px;
    letter-spacing: -0.02em;
  }

  .tela-detalhe-titulo {
    margin-top: 18px;
    font-family: var(--fonte-titulo);
    font-weight: 800;
    font-size: 20px;
    letter-spacing: -0.015em;
  }

  .tela-conectores li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 10px;
  }

  .tela-conector-texto,
  .tela-historico-texto {
    flex: 1;
    display: grid;
    gap: 1px;
  }

  .tela-conector-texto span,
  .tela-historico-texto span {
    color: var(--texto-2-escuro);
  }

  .tela-plugues {
    display: flex;
    gap: 6px;
  }

  .tela-plugues .pin-corpo {
    border: 0;
  }

  .tela-historico {
    position: relative;
    margin-top: 10px;
    display: grid;
    gap: 16px;
  }

  .tela-historico::before {
    content: '';
    position: absolute;
    left: 13px;
    top: 10px;
    bottom: 16px;
    width: 2px;
    border-radius: 1px;
    background: var(--borda-escura);
  }

  .tela-historico li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .tela-historico .pin-corpo {
    flex: none;
    width: 28px;
    height: 28px;
    border-color: var(--noite);
  }

  .tela-historico-texto {
    display: flex;
    gap: 8px;
    align-items: baseline;
  }

  .tela-ponto {
    position: relative;
    flex: none;
    width: 28px;
    height: 28px;
    border: 2px solid var(--brasa);
    border-radius: 50%;
    background: var(--noite);
  }

  .tela-ponto i {
    position: absolute;
    inset: 3px;
    border-radius: 50%;
    background: var(--brasa);
  }

  .tela-detalhe-botoes {
    position: absolute;
    inset: auto 16px 22px;
    display: grid;
    gap: 10px;
  }

  .tela-checkin {
    position: relative;
    height: 56px;
    border-radius: 28px;
    overflow: hidden;
    font-weight: 800;
    font-size: 18px;
  }

  .tela-checkin > span {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .tela-checkin-rotulo {
    background: var(--brasa);
    color: var(--noite);
    visibility: hidden;
  }

  .tela-checkin-feito {
    background: var(--grafite);
    color: var(--linho);
    border: 1.5px solid #8c7f72;
    border-radius: 28px;
  }

  .tela-secundarios {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .tela-secundarios span {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 48px;
    border: 1.5px solid #8c7f72;
    border-radius: 24px;
    background: var(--grafite);
    font-weight: 700;
    white-space: nowrap;
  }

  .dedo {
    display: none;
  }

  .fx .dedo {
    display: block;
    position: absolute;
    left: 195px;
    bottom: 36px;
    z-index: 5;
    width: 56px;
    height: 56px;
    margin-left: -28px;
    border: 3px solid var(--linho);
    border-radius: 50%;
    background: rgb(243 237 226 / 0.28);
    visibility: hidden;
  }
</style>
